t-size:18px}
}
@media(max-width:430px){
  .metrics,.cards4,.cards3,.cards2,.mini-grid,.intervention-grid,.tradeoff{grid-template-columns:1fr}
  .top-left p{max-width:42vw}
  .value{font-size:24px}
}

</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
  <div class="brand"><div class="logo">FL</div><div><h1>FoodLoop AI</h1><p>Better Decisions. Better Meals.</p></div></div>
  <button class="mobile-close" aria-label="Close navigation" onclick="closeMobileNav()">×</button>
  <div class="nav">
    <div class="section">Workspace</div>
    <button class="active" data-view="dashboard">▦ &nbsp; Dashboard</button>
    <button data-view="planning">◫ &nbsp; Planning</button>
    <button data-view="voice">◉ &nbsp; Student Voice</button>
    <button data-view="insights">◒ &nbsp; Waste & Insights</button>
    <button data-view="nutrition">◍ &nbsp; Nutrition</button>
    <button data-view="inventory">◒ &nbsp; Inventory</button>
    <button data-view="simulator">◈ &nbsp; Simulator</button>
    <button data-view="experiments">◌ &nbsp; Experiments</button>
    <div class="section">System</div>
    <button data-view="data">⌁ &nbsp; Data & Settings</button>
  </div>
  <div class="loop-strip"><div class="loop-label">The FoodLoop</div><div class="loop-path">Plan → Listen → Decide → Experiment → Learn ↺</div><div class="loop-sub">The loop is the product.</div></div>
  <div class="sidebar-foot">Tuesday · School Cafeteria<br>Workspace: Main campus</div>
</aside>
<div class="mobile-overlay" id="mobileOverlay" onclick="closeMobileNav()"></div>
<main class="main">
<header class="topbar"><div class="top-left"><h2 id="pageTitle">Dashboard</h2><p id="pageSub">Tuesday · School Cafeteria</p></div><div class="top-right"><button class="mobile-menu-btn" aria-label="Open navigation" aria-expanded="false" onclick="toggleMobileNav()">☰</button><button class="iconbtn" title="Notifications" onclick="openDrawer()">♢<span class="dot"></span></button><div class="profile">Administrator</div><div class="avatar">AD</div></div></header>
<div class="content" id="content"></div>
</main></div>
<div class="toast" id="toast"></div>
<div class="modal" id="modal"><div class="dialog"><button class="close" onclick="closeModal()">×</button><div id="modalBody"></div></div></div>
<div class="drawer" id="drawer"><button class="close" onclick="closeDrawer()">×</button><h3>Notifications</h3><div class="item"><b>High waste signal</b><p>Pasta returned food is 18% above its 6-week baseline.</p></div><div class="item"><b>Inventory risk</b><p>Tomato sauce is expected to reach expiry tomorrow.</p></div><div class="item"><b>Planning ready</b><p>Tomorrow's menu recommendation is ready for review.</p></div><div class="item"><b>Student voice</b><p>128 new responses were collected today.</p></div></div>
<script>
const state={view:'dashboard',portion:10,votes:{},expResult:false,intervention:'portion'};
const titles={dashboard:'Dashboard',planning:'Planning',voice:'Student Voice',insights:'Waste & Insights',nutrition:'Nutrition',inventory:'Inventory',simulator:'Simulator',experiments:'Experiments',data:'Data & Settings'};
const data={waste:[['Pasta',14.4,62],['Greens',19.2,18],['Rice',10.6,11],['Soup',7.3,6],['Fruit',4.8,3]]};
function showToast(t){const e=document.getElementById('toast');e.textContent=t;e.style.display='block';clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>e.style.display='none',2200)}
function showModal(title,body){document.getElementById('modalBody').innerHTML='<h3>'+title+'</h3>'+body;document.getElementById('modal').style.display='flex'}function closeModal(){document.getElementById('modal').style.display='none'}
function openDrawer(){document.getElementById('drawer').classList.add('open')}function closeDrawer(){document.getElementById('drawer').classList.remove('open')}
function toggleMobileNav(){const s=document.querySelector('.sidebar');const o=document.getElementById('mobileOverlay');const b=document.querySelector('.mobile-menu-btn');if(!s)return;const open=s.classList.toggle('open');if(o)o.classList.toggle('open',open);if(b)b.setAttribute('aria-expanded',String(open));}
function closeMobileNav(){const s=document.querySelector('.sidebar');const o=document.getElementById('mobileOverlay');const b=document.querySelector('.mobile-menu-btn');if(s)s.classList.remove('open');if(o)o.classList.remove('open');if(b)b.setAttribute('aria-expanded','false')}
function setView(v){state.view=v;document.querySelectorAll('.nav button[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===v));render();if(window.innerWidth<=760)closeMobileNav()}
function render(){document.getElementById('pageTitle').textContent=titles[state.view];const subs={dashboard:'Tuesday · School Cafeteria',planning:'Tomorrow · Menu and portion planning',voice:'Student feedback · Weekly pulse',insights:'Last 6 weeks · Waste and root causes',nutrition:'Tomorrow · Meal balance',inventory:'Today · Stock and expiry',simulator:'Before service · Scenario comparison',experiments:'Live tests · Measured outcomes',data:'Workspace configuration'};document.getElementById('pageSub').textContent=subs[state.view];document.getElementById('content').innerHTML=views[state.view]();bind()}
const views={
dashboard:()=>`
<div class="insight" style="margin-bottom:14px"><strong>Better Decisions. Better Meals. A Smarter Loop.</strong><span>Student voice, meal data and waste signals feed the next decision.</span></div><div class="grid metrics"><div class="card metric"><div class="label">Students expected</div><div class="value">720</div><div class="sub">Tomorrow lunch</div></div><div class="card metric"><div class="label">Projected waste</div><div class="value positive">8.4%</div><div class="sub">After current recommendations</div></div><div class="card metric"><div class="label">Student acceptance</div><div class="value">86%</div><div class="sub">Latest weekly pulse</div></div><div class="card metric"><div class="label">Estimated cost / meal</div><div class="value">34k₫</div><div class="sub">Planning estimate</div></div></div>
<div class="section-title"><h3>Needs attention</h3><span>Updated 2 min ago</span></div><div class="card">${[['red','Pasta waste','Returned food 18% above baseline','Investigate','insights'],['amber','Tomato sauce','Expiry risk tomorrow','Review inventory','inventory'],['amber','Tomorrow plan','Vegetable prep is above recent demand','Review plan','planning']].map(x=>`<div class="alert"><span class="marker ${x[0]}"></span><div style="flex:1"><b>${x[1]}</b><p>${x[2]}</p></div><button class="action" onclick="setView('${x[4]}')">${x[3]}</button></div>`).join('')}</div>
<div class="section-title"><h3>Tomorrow's plan</h3><button class="action primary" onclick="setView('planning')">Open planning</button></div>
<div class="card hero"><table class="table"><thead><tr><th>Meal</th><th>Planned</th><th>FoodLoop</th><th>Signal</th><th></th></tr></thead><tbody><tr><td>Chicken rice</td><td>690</td><td>690</td><td><span class="pill green">Stable</span></td><td><button class="action" onclick="setView('planning')">View</button></td></tr><tr><td>Vegetable soup</td><td>680</td><td>610</td><td><span class="pill amber">Over-prep</span></td><td><button class="action" onclick="setView('simulator')">Compare</button></td></tr><tr><td>Pasta + greens</td><td>720</td><td>680</td><td><span class="pill red">Review</span></td><td><button class="action" onclick="setView('insights')">Inspect</button></td></tr></tbody></table></div>
<div class="section-title"><h3>Waste trend</h3><span>Weekly average</span></div><div class="grid cols"><div class="card hero"><div class="row"><div><h4>Returned food</h4><p>Lower is better</p></div><span class="pill green">−3.1 pts</span></div><div class="bars">${[['W1',72,'alt'],['W2',67,'alt'],['W3',61,'alt'],['W4',55,'alt'],['W5',49,'blue'],['W6',42,'']].map(x=>`<div class="barwrap"><div class="bar ${x[2]}" style="height:${x[1]*1.65}px"></div><span>${x[0]}</span></div>`).join('')}</div></div><div class="card hero"><h4>FoodLoop signal</h4><p>What changed recently</p><div class="insight" style="margin-top:14px"><strong>Pasta</strong><span>Waste rose on pasta days. Student voice and sauce return data point to a taste-related cause.</span></div><button class="action primary" style="margin-top:12px" onclick="setView('insights')">Open insight</button></div></div>`;
