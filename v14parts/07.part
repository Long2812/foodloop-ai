ble></div></div><div class="section-title"><h3>Learning queue</h3><span>Ready for model update</span></div><div class="card hero"><div class="row"><div><h4>1 validated change</h4><p>The pasta sauce result is ready to influence future recommendations.</p></div><button class="action green" onclick="showToast('Learning update queued')">Queue learning update</button></div></div>`,
data:()=>`<div class="section-title"><h3>Data & Settings</h3><span>Workspace configuration</span></div><div class="grid cols equal"><div class="card hero"><h4>Data sources</h4><table class="table" style="margin-top:10px"><tbody><tr><td>Headcount</td><td>Daily form</td><td><span class="pill green">Connected</span></td></tr><tr><td>Menu</td><td>Admin input</td><td><span class="pill green">Connected</span></td></tr><tr><td>Waste</td><td>Weight / photo</td><td><span class="pill blue">Prototype</span></td></tr><tr><td>Student Voice</td><td>Quick survey</td><td><span class="pill green">Connected</span></td></tr><tr><td>Inventory</td><td>Daily stock</td><td><span class="pill green">Connected</span></td></tr></tbody></table></div><div class="card hero"><h4>Decision objectives</h4><div style="display:grid;gap:12px;margin-top:14px">${[['Waste','Reduce',82],['Student acceptance','Increase',86],['Nutrition','Maintain',91],['Cost','Control',79]].map(x=>`<div><div class="row"><span class="tiny">${x[0]}</span><span class="tiny">${x[1]}</span></div><div class="progress" style="margin-top:6px"><i style="width:${x[2]}%"></i></div></div>`).join('')}</div></div></div><div class="section-title"><h3>Trust & governance</h3><span>Prototype principles</span></div><div class="cards3"><div class="card hero"><h4>Observed vs predicted</h4><p>UI labels distinguish measured data from model forecasts and targets.</p></div><div class="card hero"><h4>Human approval</h4><p>Recommendations are reviewed before menu, portion or procurement changes are applied.</p></div><div class="card hero"><h4>Minimum data</h4><p>Student feedback is aggregated for planning; personal identity is not needed for the MVP.</p></div></div>`
};
function selectMeal(i){state.votes.meal=i;render()}function setVote(i,r){state.votes={meal:i,rating:r};showToast('Preference recorded');render()}
function chooseIntervention(type){state.intervention=type;const cfg={portion:{waste:'9.7%',acc:'82%',nut:89,cost:'34k₫',prep:680,title:'Reduce regular portion by 10%',reason:'Portion preference signals are strong. This option lowers projected waste, but the nutrition score falls below the preferred 90 threshold, so it needs review before approval.'},recipe:{waste:'8.9%',acc:'84%',nut:92,cost:'34k₫',prep:680,title:'Change pasta sauce recipe',reason:'Student feedback points to sauce taste as a major signal. The scenario lowers projected waste while keeping the meal balance above the nutrition threshold.'},prep:{waste:'9.4%',acc:'83%',nut:93,cost:'35k₫',prep:690,title:'Adjust preparation method',reason:'A preparation change may improve appeal and reduce returns without changing the core ingredients. The model keeps the nutrition score within target.'},serving:{waste:'8.6%',acc:'85%',nut:92,cost:'35k₫',prep:700,title:'Serve sauce separately',reason:'Separating sauce gives students more control and may reduce sauce waste while preserving the rest of the meal.'}}[type];['portion','recipe','prep','serving'].forEach(x=>document.getElementById('iv-'+x).classList.toggle('active',x===type));document.getElementById('simWaste').textContent=cfg.waste;document.getElementById('simAcc').textContent=cfg.acc;document.getElementById('simNut').textContent=cfg.nut;document.getElementById('simCost').textContent=cfg.cost;document.getElementById('simPrep').textContent=cfg.prep;document.getElementById('simTitle').textContent=cfg.title;document.getElementById('simReason').textContent=cfg.reason;document.getElementById('guardScore').textContent=cfg.nut+' · '+(cfg.nut>=90?'Pass':'Review');document.getElementById('guardrails').querySelector('.guard:nth-child(3)').className='guard '+(cfg.nut>=90?'ok':'warn');document.getElementById('guardOverall').textContent=cfg.nut>=90?'Pass':'Review';document.getElementById('guardrails').querySelector('.guard:nth-child(4)').className='guard '+(cfg.nut>=90?'ok':'warn');document.getElementById('simStatus').textContent=cfg.nut>=90?'Ready for experiment':'Nutrition review required';}
function adjustPortion(d){chooseIntervention('portion')}
function createExperiment(){showModal('Create experiment','<p><b>Hypothesis:</b> Smaller regular portion will reduce returned food while keeping acceptance above target.</p><p><b>Scope:</b> 100 students · 2 lunch services.</p><p><b>Baseline:</b> 12.0% projected waste.</p><button class="action primary" style="margin-top:8px" onclick="closeModal();showToast(\'Experiment EXP-016 created\');setTimeout(()=>setView(\'experiments\'),300)">Create EXP-016</button>')}
function addResults(){showToast('Results added to FoodLoop learning queue')}
function openEvidence(meal){showModal(meal+' · Evidence','<p><b>Observed:</b> recent return rate is elevated.</p><p><b>Signals:</b> waste trend, student feedback and portion data.</p><p><b>Next action:</b> run a small experiment before changing the full menu.</p>')}
function bind(){document.querySelectorAll('.nav button[data-view]').forEach(b=>b.onclick=()=>setView(b.dataset.view))}
render();
</script>
</body></html>