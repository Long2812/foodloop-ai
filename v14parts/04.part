food 18% above baseline','Investigate','insights'],['amber','Tomato sauce','Expiry risk tomorrow','Review inventory','inventory'],['amber','Tomorrow plan','Vegetable prep is above recent demand','Review plan','planning']].map(x=>`<div class="alert"><span class="marker ${x[0]}"></span><div style="flex:1"><b>${x[1]}</b><p>${x[2]}</p></div><button class="action" onclick="setView('${x[4]}')">${x[3]}</button></div>`).join('')}</div>
<div class="section-title"><h3>Tomorrow's plan</h3><button class="action primary" onclick="setView('planning')">Open planning</button></div>
<div class="card hero"><table class="table"><thead><tr><th>Meal</th><th>Planned</th><th>FoodLoop</th><th>Signal</th><th></th></tr></thead><tbody><tr><td>Chicken rice</td><td>690</td><td>690</td><td><span class="pill green">Stable</span></td><td><button class="action" onclick="setView('planning')">View</button></td></tr><tr><td>Vegetable soup</td><td>680</td><td>610</td><td><span class="pill amber">Over-prep</span></td><td><button class="action" onclick="setView('simulator')">Compare</button></td></tr><tr><td>Pasta + greens</td><td>720</td><td>680</td><td><span class="pill red">Review</span></td><td><button class="action" onclick="setView('insights')">Inspect</button></td></tr></tbody></table></div>
<div class="section-title"><h3>Waste trend</h3><span>Weekly average</span></div><div class="grid cols"><div class="card hero"><div class="row"><div><h4>Returned food</h4><p>Lower is better</p></div><span class="pill green">−3.1 pts</span></div><div class="bars">${[['W1',72,'alt'],['W2',67,'alt'],['W3',61,'alt'],['W4',55,'alt'],['W5',49,'blue'],['W6',42,'']].map(x=>`<div class="barwrap"><div class="bar ${x[2]}" style="height:${x[1]*1.65}px"></div><span>${x[0]}</span></div>`).join('')}</div></div><div class="card hero"><h4>FoodLoop signal</h4><p>What changed recently</p><div class="insight" style="margin-top:14px"><strong>Pasta</strong><span>Waste rose on pasta days. Student voice and sauce return data point to a taste-related cause.</span></div><button class="action primary" style="margin-top:12px" onclick="setView('insights')">Open insight</button></div></div>`,
planning:()=>`<div class="section-title"><h3>Menu planning</h3><div class="filters"><select><option>Tomorrow</option><option>Wednesday</option></select><select><option>All meals</option></select></div></div><div class="card hero"><div class="row"><div><h4>Tomorrow · 720 expected students</h4><p>Recommendations reflect recent demand, waste and student voice.</p></div><span class="pill blue">AI recommendation ready</span></div><table class="table" style="margin-top:12px"><thead><tr><th>Meal</th><th>Current plan</th><th>FoodLoop</th><th>Smart portion</th><th></th></tr></thead><tbody><tr><td>Chicken rice</td><td>700</td><td><b>690</b></td><td>Regular</td><td><button class="action" onclick="setView('simulator')">Simulate</button></td></tr><tr><td>Vegetable soup</td><td>680</td><td><b>610</b></td><td>Regular</td><td><button class="action" onclick="setView('simulator')">Simulate</button></td></tr><tr><td>Pasta + greens</td><td>720</td><td><b>680</b></td><td>Small + Regular</td><td><button class="action primary" onclick="setView('simulator')">Review</button></td></tr></tbody></table></div><div class="section-title"><h3>Smart portion</h3><span>Based on student choice signals</span></div><div class="cards3"><div class="card hero"><div class="label">Small</div><div class="value" style="font-size:24px">180</div><div class="sub">25% of students</div></div><div class="card hero"><div class="label">Regular</div><div class="value" style="font-size:24px">450</div><div class="sub">62% of students</div></div><div class="card hero"><div class="label">Large</div><div class="value" style="font-size:24px">90</div><div class="sub">13% of students</div></div></div><div class="section-title"><h3>Planning evidence</h3><span>Why is the recommendation different?</span></div><div class="card hero"><div class="insight"><strong>Evidence</strong><span>60% of surveyed students said the current portion was too large, and 75% wanted another portion option. The recommendation lowers regular rice volume while keeping a large option available.</span></div></div>`,
voice:()=>`<div class="section-title"><h3>Student Voice</h3><span>1,248 responses this term</span></div><div class="voice-grid"><div class="card hero"><div class="row"><div><h4>Quick pulse</h4><p>Choose your preference for tomorrow's menu.</p></div><span class="pill green">Live</span></div><div class="cards2" style="margin-top:14px">${[['Pasta','🍝'],['Rice + chicken','🍗'],['Soup + greens','🥗']].map((x,i)=>`<div class="vote-card ${state.votes.meal===i?'selected':''}" onclick="selectMeal(${i})"><div class="food">${x[1]} ${x[0]}</div><div class="vote-row"><button class="choice ${state.votes.rating===2&&state.votes.meal===i?'active':''}" onclick="event.stopPropagation();setVote(${i},2)">Love it</button><button class="choice ${state.votes.rating===1&&state.votes.meal===i?'active':''}" onclick="event.stopPropagation();setVote(${i},1)">Okay</button><button class="choice ${state.votes.rating===0&&state.votes.meal===i?'active':''}" onclick="event.stopPropagation();setVote(${i},0)">Not for me</button></div></div>`).join('')}</div><div style="margin-top:16px"><div class="label">Portion</div><div class="vote-row"><button class="choice" onclick="showToast('Small portion preference recorded')">Small</button><button class="choice" onclick="showToast('Regular portion preference recorded')">Regular</button><button class="choice" onclick="showToast('Large portion preference recorded')">Large</button></div></div></div><div class="card hero"><div class="row"><div><h4>What students are saying</h4><p>AI groups comments into themes.</p></div><span class="pill blue">128 new</span></div><div class="mini-grid" style="margin-top:14px"><div class="mini"><b>Portion</b><strong>42%</strong><div class="sub">of negative feedback</div></div><div class="mini"><b>Taste</b><strong>31%</strong><div class="sub">of negative feedback</div></div><div class="mini"><b>Ingredients</b><strong>17%</strong><div class="sub">of negative feedback</div></div><div class="mini"><b>Other</b><strong>10%